{
  "name": "@jsnw/srv-utils",
  "version": "2.1.0",
  "description": "Server-side utilities for Node.js/TypeScript: tsconfig paths, Nest helpers, and config loading.",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "node": {
      "default": "./dist/index.cjs",
      "types": "./dist/index.d.cts"
    }

    "util",
    "utils"
  ],
  "author": {
    "name": "Pavlo Baliuk",
    "email": "jsnow0177@gmail.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pvbaliuk/jsn-srv-utils/issues"
  },
  "homepage": "https://github.com/pvbaliuk/jsn-srv-utils#readme",
  "dependencies": {
    "@jsnw/common-utils": "catalog:",
    "ms": "catalog:",
    "yaml": "catalog:",
